# Copiar a .env.local y completar con los valores del proyecto en Supabase.
# Dashboard > Project Settings > API
# El valor de ANON_KEY puede ser la publishable key moderna (sb_publishable_...)
# o la anon key heredada. Ambas son seguras en el navegador; RLS manda.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
